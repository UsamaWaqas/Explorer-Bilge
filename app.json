{
  "expo": {
    "name": "MyARMIT",
    "slug": "myarmit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/svg/ARMIT-Bg.png",
    "scheme": "myarmit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/svg/ARMIT-Bg.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goarmit.app",
      "associatedDomains": [
        "applinks:aquamax-devstage.jove1.com"
       
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.goarmit.app",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/svg/ARMIT-adaptive-v2.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aquamax-devstage.jove1.com",
              "pathPrefix": "/account-details"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/svg/armit_final.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-font",
      "expo-web-browser",
      [
        "expo-adi-registration",
        {
          "token": "DU7CREWOR5TO2AAAAAAAAAAAAA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "screen2meServer": "https://screen2me.jove1.com",
      "router": {},
      "eas": {
        "projectId": "e0075689-cbdb-4411-b197-d6090442cfe4"
      }
    }
  }
}
