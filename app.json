{
  "expo": {
    "name": "My-Armit",
    "slug": "My-Armit",
    "version": "1.0.0",
    "orientation": "portrait",
    // "icon": "./assets/images/armIT_logo.png",
    "scheme": "myarmit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usama.myarmit"
    },
    "android": {
      "package": "com.usama.myarmit",
      "adaptiveIcon": {
        // "foregroundImage": "./assets/images/armIT_logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5eb478ba-81df-4ad5-86aa-3a90a71eff46"
      }
    }
  }
}