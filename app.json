{
  "expo": {
    "name": "My-Armit",
    "slug": "my-armit",
    "owner": "chirptech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/svg/FavIcon_MyARMIT.png",
    "scheme": "myarmit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/svg/FavIcon_MyARMIT.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ChirpTech.myarmit",
      "associatedDomains": [
        "applinks:api.example.com"
      ]
    },
    "android": {
      "package": "com.ChirpTech.myarmit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/svg/armit_final.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.example.com",
              "pathPrefix": "/account-details"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/svg/armit_final.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "952d9fd1-405b-4409-bd1c-872d9c807ff2"
      }
    }
  }
}