{
  "cli": {
    "version": ">= 18.0.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyPath": "./keys/AuthKey_ASC_KEY_ID_REDACTED.p8",
        "ascApiKeyIssuerId": "ASC_ISSUER_ID_REDACTED",
        "ascApiKeyId": "ASC_KEY_ID_REDACTED"
      }
    }
  }
}
